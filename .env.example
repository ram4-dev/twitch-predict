# Server-only. Never prefix BYTE_API_KEY with PUBLIC_ or VITE_.
BYTE_API_KEY=
BYTE_BASE_URL=https://app.bytearena.fun
BYTE_RPC_URL=https://api.devnet.solana.com
MARKET_MODE=byte

# Optional comma-separated operator wallet addresses.
# Empty: the existing bridge token authorizes this machine's local operator panel.
# The server binds to 127.0.0.1; do not expose local operator mode to the internet.
BYTE_OPERATOR_WALLETS=

# Chrome Web Store publishing (configure as GitHub Actions secrets).
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=
CWS_REFRESH_TOKEN=
CWS_EXTENSION_ID=
CWS_PUBLISHER_ID=
