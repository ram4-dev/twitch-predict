{
  "manifest_version": 3,
  "name": "Twitch → Solana · Prediction Mirror",
  "version": "0.2.0",
  "description": "Muestra las apuestas por puntos de Twitch y crea su mercado automáticamente en el puente de la POC.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://gql.twitch.tv/*",
    "http://twitch-predict.localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Prediction Mirror · Ver apuesta"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://twitch-predict.localhost/*"
    ]
  }
}
