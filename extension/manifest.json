{
  "manifest_version": 3,
  "name": "plot",
  "version": "0.11.2",
  "description": "Predicciones de Twitch y apuestas en SOL devnet desde el stream.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://gql.twitch.tv/*",
    "http://twitch-predict.localhost/*",
    "http://127.0.0.1/*",
    "https://twitch-predict.localhost/*",
    "http://twitch-predict-byte.localhost/*",
    "https://twitch-predict-byte.localhost/*",
    "https://www.twitch.tv/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "plot · Ver apuesta"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://twitch-predict.localhost/*",
      "https://twitch-predict.localhost/*",
      "http://twitch-predict-byte.localhost/*",
      "https://twitch-predict-byte.localhost/*"
    ]
  },
  "key": ""
}
