{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "paths": {
      "@/lib/*": [
        "./lib/*.ts"
      ],
      "@/components/ui/*": [
        "./components/ui/*.tsx"
      ],
      "@/components/*": [
        "./components/*.tsx"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts",
    "src/**/*.tsx",
    "components/**/*.tsx",
    "lib/**/*.ts"
  ]
}
